# Copy to .env and edit. Every value below is optional — with no .env at all,
# Chatterly runs on the built-in `echo` provider and needs no model installed.

# echo | openai-compatible
CHATTERLY_PROVIDER=echo

# Any OpenAI-compatible server:
#   Ollama     http://localhost:11434/v1
#   LM Studio  http://localhost:1234/v1
#   llama.cpp  http://localhost:8080/v1
CHATTERLY_BASE_URL=http://localhost:11434/v1
CHATTERLY_MODEL=qwen3:4b

# Most local servers ignore this, but send one if yours requires it.
CHATTERLY_API_KEY=not-needed

# Can the chosen MODEL do native function calling? This is a property of the model, not
# the server — one Ollama instance serves models that can and cannot, and the endpoint
# cannot be asked. Check with:  ollama show <model>   (look for "tools" under Capabilities)
CHATTERLY_NATIVE_TOOLS=true

# auto | native | prompted
# auto follows CHATTERLY_NATIVE_TOOLS; naming one overrides it, which is how you A/B them.
CHATTERLY_TOOL_PROTOCOL=auto

CHATTERLY_TEMPERATURE=0.7
CHATTERLY_MAX_STEPS=6
CHATTERLY_TOOL_TIMEOUT_MS=10000
CHATTERLY_CONTEXT_BUDGET_CHARS=12000
CHATTERLY_DATA_DIR=.data
CHATTERLY_SYSTEM_PROMPT=
